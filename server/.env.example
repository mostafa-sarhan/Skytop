# Development settings. Copy to server/.env and fill in real values.
# Never commit server/.env. Production does NOT read this file: it uses
# /etc/skytop/server.env (see deploy/env/server.env.example and deploy/README.md).
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN=12h
# true in production (HTTPS only)
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:5173"
# Client IP source for rate limits/logs: false (no proxy) | loopback (Nginx on the same host)
TRUST_PROXY=false
# Private storage for passports, photos, receipt scans and invoices (relative to server/ in development)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAILURES_PER_ACCOUNT=10
SENSITIVE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=120

# First manager, created by `npm run seed` if the username does not exist yet.
# New usernames: >= 6 characters (letters, digits, . _ -).
# New passwords: >= 10 characters with upper, lower, digit and special character.
SEED_MANAGER_USERNAME=CHANGE_ME
SEED_MANAGER_PASSWORD="CHANGE_ME"
SEED_MANAGER_FULL_NAME=مدير النظام
# Optional starter employee (only created when SEED_EMPLOYEE_PASSWORD is set)
# SEED_EMPLOYEE_USERNAME=CHANGE_ME
# SEED_EMPLOYEE_PASSWORD="CHANGE_ME"
# SEED_EMPLOYEE_FULL_NAME=موظف العمليات
