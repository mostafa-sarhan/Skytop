# Copy to server/.env and fill in real values. Never commit server/.env.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN=12h
# Set to true in production (HTTPS)
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:5173"
# Private storage for passport images and receipt scans (relative to server/)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10

# Initial accounts created by `prisma/seed.ts` — set strong passwords.
SEED_MANAGER_USERNAME=admin
SEED_MANAGER_PASSWORD="CHANGE_ME"
SEED_MANAGER_FULL_NAME=مدير النظام
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD="CHANGE_ME"
SEED_EMPLOYEE_FULL_NAME=موظف العمليات
