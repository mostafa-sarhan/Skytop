# ---------------------------------------------------------------
# Sky-Top — repository-wide ignore rules (client + server)
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment / secrets (only the example files are committed)
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx

# Private uploads: passport images, personal photos, receipt scans.
# Stored under server/<UPLOAD_DIR> (default "uploads").
uploads/
server/uploads/
storage/
private/

# Databases and dumps (Prisma migrations are kept below)
*.dump
*.backup
*.bak
*.sql
!server/prisma/migrations/**/*.sql
*.sqlite
*.sqlite3
*.db
.prisma/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests / coverage / caches
coverage/
.nyc_output/
.cache/
.eslintcache
.vite/

# Temporary files
.tmp/
tmp/
temp/
*.tmp
*.swp
*.sw?

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / local tool settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.claude/
