# /etc/skytop/docker.env — production settings for the Docker stack.
# Owner root:root, mode 0600. Used by deploy/scripts/compose.sh as
# `docker compose --env-file`; docker-compose.prod.yml passes each container
# only the values it needs. Replace every CHANGE_ME / YOUR_ value: compose
# refuses to start when a required value is missing, and the API refuses to
# start while a placeholder or an unsafe value remains.
# Format: KEY=value, no spaces around "=", no quotes. Generate secrets with
# openssl (hex: safe inside the database URL and in shell scripts).

# --- PostgreSQL (container "postgres", never published) ---------------------
POSTGRES_DB=skytop
POSTGRES_USER=skytop
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- API (container "backend") ---------------------------------------------
# openssl rand -hex 32   (changing it signs everybody out)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=12h
# The public site = the browser origin. No trailing slash, no wildcard.
CORS_ORIGIN=https://YOUR_DOMAIN
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=8388608
# Rate limits (one API container, in-memory). Per client IP; an office behind
# one router shares one IP, so RATE_LIMIT_MAX covers all staff.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAILURES_PER_ACCOUNT=10
SENSITIVE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=120
LOG_LEVEL=info

# --- Host side --------------------------------------------------------------
# Private files on the host (bind-mounted into the backend only).
# Must exist, owned by 10001:10001, mode 700.
UPLOADS_DIR=/var/lib/skytop/uploads
# Loopback ports the host Nginx proxies to (never public).
BACKEND_PORT=4000
FRONTEND_PORT=8080
# Docker network for the published ports. The API trusts X-Forwarded-For only
# from loopback and this gateway (the address the host Nginx connects from).
# Change both together if 172.30.80.0/24 is already used on the server.
SKYTOP_SUBNET=172.30.80.0/24
SKYTOP_GATEWAY=172.30.80.1
