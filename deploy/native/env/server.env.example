# /etc/skytop/server.env — production settings for the Sky Top API.
# Owner root:skytop, mode 0640. Read by systemd (EnvironmentFile) and by the
# deploy/backup scripts. Replace every YOUR_* / CHANGE_ME value: the API
# refuses to start while a placeholder or an unsafe value remains.
# Values: KEY=value, no spaces around "=", no quotes needed (avoid spaces and
# the characters $ ` " \ in secrets — generate them with `openssl rand -hex 32`).

NODE_ENV=production
# Listen on loopback only: Nginx is the only way in.
HOST=127.0.0.1
PORT=4000

# PostgreSQL on the same VPS (password: openssl rand -hex 24)
DATABASE_URL=postgresql://skytop:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/skytop

# Session tokens (openssl rand -hex 32). Changing it signs everybody out.
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_EXPIRES_IN=12h
COOKIE_SECURE=true

# The public site (the browser origin). No trailing slash, no wildcard.
CORS_ORIGIN=https://YOUR_DOMAIN
# Nginx runs on the same machine: trust X-Forwarded-For from loopback only.
TRUST_PROXY=loopback

# Private files — durable, outside the release folder, never served by Nginx.
UPLOAD_DIR=/var/lib/skytop/uploads
MAX_UPLOAD_BYTES=8388608

# Rate limits (single API process, in-memory). Limits are per client IP and
# an office behind one router shares one IP: RATE_LIMIT_MAX covers all staff.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAILURES_PER_ACCOUNT=10
SENSITIVE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=120

LOG_LEVEL=info
